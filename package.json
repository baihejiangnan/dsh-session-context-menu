{
  "name": "@baihejiangnan/dsh-session-context-menu",
  "version": "0.2.14",
  "description": "更好的右键：为 DeepSeek Harness 应用封装端提供原生风格的完整上下文菜单。",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-menu",
    "tauri",
    "webview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baihejiangnan/dsh-session-context-menu.git"
  },
  "homepage": "https://github.com/baihejiangnan/dsh-session-context-menu#readme",
  "bugs": {
    "url": "https://github.com/baihejiangnan/dsh-session-context-menu/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.0-rc.6"
  },
  "license": "MIT"
}
